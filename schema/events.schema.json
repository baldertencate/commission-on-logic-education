{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logic-education-resources.example/schema/events.schema.json",
  "title": "Logic education events collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "events"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "events": {
      "type": "array",
      "items": {
