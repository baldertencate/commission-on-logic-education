{
  "name": "logic-education-resources",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A community-maintained catalogue of resources for teaching and learning logic.",
  "scripts": {
    "build": "tsx scripts/build-catalogue.ts",
    "build:site": "vite build && tsx scripts/build-catalogue.ts dist/catalogue.json",
    "audit:urls": "tsx scripts/audit-urls.ts",
    "check": "tsx scripts/check.ts",
    "check:submitted-urls": "tsx scripts/submission-url-check.ts",
    "dev": "npm run build && vite",
    "generate:suggestion": "tsx scripts/create-resource-from-issue.ts",
    "preview": "vite preview",
    "test": "npm run check && npm run test:search && npm run test:suggestion && npm run test:url-check",
    "test:search": "tsx scripts/test-search.ts",
    "test:suggestion": "tsx scripts/test-suggestion.ts",
    "test:url-check": "tsx scripts/test-url-check.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cheerio": "^1.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=22"
  }
}
